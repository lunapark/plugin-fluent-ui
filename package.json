{
    "name": "@luna-park/plugin-fluent-ui",
    "version": "1.0.0",
    "private": false,
    "description": "Fluent 2 web components for Luna Park, for apps that feel native on Windows",
    "keywords": [
        "luna-park",
        "plugin",
        "fluent",
        "fluent-ui",
        "ui"
    ],
    "homepage": "https://luna-park.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/lunapark/plugin-fluent-ui"
    },
    "author": {
        "name": "Luna Park",
        "url": "https://luna-park.app"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        },
        "./runtime": {
            "import": "./dist/runtime.js"
        }
    },
    "module": "./dist/index.js",
    "files": [
        "dist/**",
        "src/logo.svg"
    ],
    "scripts": {
        "build": "vite build",
        "prepublishOnly": "pnpm run build",
        "dev": "vite build --watch",
        "preview": "luna-preview",
        "typecheck": "vue-tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@fluentui/tokens": "1.0.0-alpha.24",
        "@fluentui/web-components": "^3.2.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@microsoft/fast-element": "^3.0.0",
        "@microsoft/focusgroup-polyfill": "^1.5.0",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@luna-park/design": "^1.7.0",
        "@luna-park/eslint-config": "^1.4.5",
        "@luna-park/plugin": "^2.3.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "@fluentui/tokens": "1.0.0-alpha.24",
        "@fluentui/web-components": "^3.2.1",
        "@luna-park/design": "^1.7.0",
        "@microsoft/fast-element": "^3.0.0",
        "@microsoft/focusgroup-polyfill": "^1.5.0",
        "vue": "^3.5.43"
    }
}
